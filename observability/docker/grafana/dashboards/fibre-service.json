  "templating": {
    "list": [
      {
        "allValue": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "multi": true,
        "name": "host",
        "query": {
          "query": "label_values(node_uname_info, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "multi": true,
        "name": "fibre_instance",
        "query": {
          "query": "label_values(go_goroutine_count, service_instance_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "multi": true,
        "name": "service",
        "query": {
          "query": "label_values(node_systemd_unit_state{instance=~\"$host\",name=~\".*fibre.*|.*encoder.*\"}, name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "type": "query"
      },
      {
        "name": "chain",
        "type": "query",
        "query": "label_values(up,chain_id)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": false,
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "time": {
