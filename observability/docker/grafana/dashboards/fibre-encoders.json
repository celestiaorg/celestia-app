    {
      "id": 500,
      "title": "TOTAL payload input rates \u2014 admitted / dispatched / confirmed / unknown",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Unique admitted payload inputs, not all WS/HTTP requests. Retries, status polls and pre-admission rejects are excluded. Memory-ledger confirmed/unknown totals are monotonic across receipt eviction but reset on process restart; rate handles resets. Cohorts can cross window boundaries. Unknown is unresolved, not definitive failure.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:inputs/s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((max by(component_id)(rate(fibre_encoder_admitted_inputs_total{chain_id=\"$chain\",job=\"workload\",component_id=~\"$encoder\"}[1m])) and on(component_id) max by(component_id)(fibre_bench_identity_info{chain_id=\"$chain\",job=\"workload\",component_id=~\"$encoder\",run_id=~\"$run\"})))",
          "legendFormat": "TOTAL unique admitted inputs/s"
        },
        {
          "refId": "B",
          "expr": "sum((max by(component_id)(rate(fibre_encoder_dispatch_batch_inputs_sum{chain_id=\"$chain\",job=\"workload\",component_id=~\"$encoder\"}[1m])) and on(component_id) max by(component_id)(fibre_bench_identity_info{chain_id=\"$chain\",job=\"workload\",component_id=~\"$encoder\",run_id=~\"$run\"})))",
          "legendFormat": "TOTAL dispatched inputs inputs/s"
        },
        {
          "refId": "C",
          "expr": "sum((max by(component_id)(rate(fibre_encoder_ledger_inputs{chain_id=\"$chain\",job=\"workload\",component_id=~\"$encoder\",state=\"confirmed\"}[1m])) and on(component_id) max by(component_id)(fibre_bench_identity_info{chain_id=\"$chain\",job=\"workload\",component_id=~\"$encoder\",run_id=~\"$run\"})))",
          "legendFormat": "TOTAL confirmed outcomes inputs/s"
        },
        {
          "refId": "D",
          "expr": "sum((max by(component_id)(rate(fibre_encoder_ledger_inputs{chain_id=\"$chain\",job=\"workload\",component_id=~\"$encoder\",state=\"unknown\"}[1m])) and on(component_id) max by(component_id)(fibre_bench_identity_info{chain_id=\"$chain\",job=\"workload\",component_id=~\"$encoder\",run_id=~\"$run\"})))",
          "legendFormat": "TOTAL unknown outcomes inputs/s"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 74,
        "w": 12,
        "h": 8
      }
