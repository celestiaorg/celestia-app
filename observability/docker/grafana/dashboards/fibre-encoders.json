          "expr": "sum((max by(component_id)(rate(fibre_bench_raw_bytes_total{chain_id=\"$chain\",job=\"workload\",role=\"encoder\",component_id=~\"$encoder\",boundary=\"encoder_admitted\"}[1m])) and on(component_id) max by(component_id)(fibre_bench_identity_info{chain_id=\"$chain\",job=\"workload\",role=\"encoder\",run_id=~\"$run\"}))) / 1073741824",
