      "title": "TOTAL average admitted payload bytes per input",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Raw admitted bytes / unique admitted input count. Weighted mean only, not percentile/min/max. No admissions yields no data.",
