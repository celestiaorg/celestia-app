{
  "uid": "fibre-txsim",
  "title": "Fibre Uploader Simulator",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "fibre",
    "txsim"
  ],
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(fibre_txsim_encoding_active, instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Raw throughput \u2014 fleet",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Stages are separate pipeline checkpoints; do not add them. Upload = quorum receipt. Confirmation = observed successful execution.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(fibre_txsim_raw_bytes_total{instance=~\"$instance\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Raw throughput \u2014 per instance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance,stage) (rate(fibre_txsim_raw_bytes_total{instance=~\"$instance\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{stage}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Padded/billed throughput \u2014 fleet",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Stages are separate pipeline checkpoints; do not add them. Upload = quorum receipt. Confirmation = observed successful execution.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(fibre_txsim_padded_bytes_total{instance=~\"$instance\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Padded/billed throughput \u2014 per instance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance,stage) (rate(fibre_txsim_padded_bytes_total{instance=~\"$instance\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{stage}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Blob rate \u2014 fleet",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Stages are separate pipeline checkpoints; do not add them. Upload = quorum receipt. Confirmation = observed successful execution.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(fibre_txsim_blobs_total{instance=~\"$instance\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Blob rate \u2014 per instance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance,stage) (rate(fibre_txsim_blobs_total{instance=~\"$instance\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{stage}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Unsuccessful / unresolved outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Timeout, unknown and untracked may still settle later. Confirmed totals are lower bounds when these occur.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage,outcome) (rate(fibre_txsim_blobs_total{instance=~\"$instance\",outcome!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Unresolved confirmation bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(fibre_txsim_raw_bytes_total{instance=~\"$instance\",stage=\"confirmation\",outcome=~\"timeout|unknown|untracked\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Pending confirmations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fibre_txsim_confirmation_pending{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Confirmation latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Encoding start to observed successful execution, including confirmation queue wait.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,instance) (rate(fibre_txsim_confirmation_duration_seconds_bucket{instance=~\"$instance\",outcome=\"success\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Active encodings",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fibre_txsim_encoding_active{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Resident process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Linux RSS includes resident mmap pages; unsupported platforms omit samples.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fibre_txsim_process_rss_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Codec pool capacity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance,state) (fibre_txsim_pool_bytes{instance=~\"$instance\",state=~\"in_use|free\"})",
          "legendFormat": "{{instance}} {{state}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Mapped pool capacity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Overlaps in-use/free capacity; do not sum with other pool gauges. Capacity is not RSS.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (fibre_txsim_pool_bytes{instance=~\"$instance\",state=\"mapped\"})",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
