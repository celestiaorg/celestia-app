	// fsboot reads genesis.json with the SDK's AppGenesis, as celestia-appd does.
	cosmossdk.io/api => github.com/celestiaorg/cosmos-sdk/api v0.7.9
	cosmossdk.io/log => github.com/celestiaorg/cosmos-sdk/log v1.3.0
